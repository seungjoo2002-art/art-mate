# =============================================================================
# ART MATE API 환경변수 예시
#   cp .env.example .env   후 값을 채우세요. (.env 는 절대 커밋하지 않습니다)
#   운영(Render 등)에서는 .env 파일 대신 플랫폼의 환경변수 설정을 사용합니다.
# =============================================================================

# --- Application -------------------------------------------------------------
APP_NAME=ART MATE API
APP_VERSION=0.1.0
# development | test | staging | production
APP_ENV=development
# staging/production 에서는 반드시 false (true면 기동 실패)
DEBUG=true
API_V1_PREFIX=/api/v1
# 비워두면 development/test 에서만 /docs, /redoc, /openapi.json 공개
DOCS_ENABLED=

# --- Database (Supabase PostgreSQL) -----------------------------------------
# Supabase 대시보드 > Connect 에서 복사. postgresql:// 형식이면 자동으로 asyncpg 드라이버로 변환됩니다.
# 상시 실행 서버(Render)는 Session pooler(포트 5432) 권장.
#   예) postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# 비워두면 DB 기능 비활성 (서버는 기동, /api/v1/health/db 는 503 DATABASE_NOT_CONFIGURED)
DATABASE_URL=

# 연결 풀 (기본값으로 충분, Supabase 플랜의 최대 연결 수를 넘지 않게 조정)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=10
DB_POOL_RECYCLE=1800
DB_CONNECT_TIMEOUT=5
DB_HEALTH_TIMEOUT=3
# 비워두면 포트 6543(Transaction pooler)일 때 자동으로 prepared statement 비활성화
DB_DISABLE_PREPARED_STATEMENTS=

# --- Supabase Auth -----------------------------------------------------------
# 프로젝트 URL (대시보드 > Project Settings > API > Project URL), 예) https://<project-ref>.supabase.co
# 백엔드는 이 값으로 JWT 발급자(iss)와 공개키(JWKS)를 확인합니다. 비워두면 인증 API는 모두 401.
SUPABASE_URL=
# 공개 anon(publishable) 키. v0.4부터 Storage API 호출의 apikey 헤더로 사용합니다.
# (권한은 사용자 access token + Storage RLS로 판단) service_role 키는 이 백엔드에 넣지 않습니다.
# SUPABASE_URL 과 이 값이 모두 있어야 작품 사진 API가 동작합니다 (없으면 503 STORAGE_NOT_CONFIGURED).
SUPABASE_ANON_KEY=
AUTH_JWT_AUDIENCE=authenticated
# 서버 간 시계 오차 허용 (초)
AUTH_JWT_LEEWAY_SECONDS=10
# JWKS 공개키 캐시 시간 (초)
AUTH_JWKS_CACHE_SECONDS=600

# --- Supabase Storage (v0.4 작품 사진) ----------------------------------------
# 비공개 버킷. backend/supabase/storage-setup.sql 의 버킷 이름·제한과 맞춥니다.
STORAGE_BUCKET=artworks
STORAGE_TIMEOUT_SECONDS=10
# 사진 조회 Signed URL 만료 (초, 30~3600)
STORAGE_SIGNED_URL_SECONDS=300
# 업로드 요청 후 완료 처리까지 허용 시간 (초, 60~7200)
ARTWORK_UPLOAD_TTL_SECONDS=3600
# 최대 파일 크기 (바이트), 허용 형식 (쉼표 구분: image/jpeg, image/png, image/webp)
ARTWORK_MAX_UPLOAD_BYTES=10485760
ARTWORK_ALLOWED_CONTENT_TYPES=image/jpeg,image/png,image/webp
ARTWORK_MAX_PHOTOS_PER_STAGE=10
ARTWORK_MAX_IMAGE_PIXELS=50000000

# --- 피드백 녹음 (v0.5) -------------------------------------------------------
# 비공개 오디오 버킷 (storage-setup.sql 과 동일하게)
RECORDING_BUCKET=feedback-audio
RECORDING_UPLOAD_TTL_SECONDS=3600
RECORDING_MAX_UPLOAD_BYTES=26214400
RECORDING_MAX_DURATION_SECONDS=1200
# 쉼표 구분: audio/webm, audio/ogg, audio/mp4, audio/mpeg, audio/wav
RECORDING_ALLOWED_CONTENT_TYPES=audio/webm,audio/ogg,audio/mp4,audio/mpeg,audio/wav
RECORDING_MAX_PER_ARTWORK=20
# 녹음 동의서 버전. 바꾸면 학생은 새 버전에 다시 동의해야 녹음 가능
RECORDING_CONSENT_VERSION=2026-11-v1

# --- AI 첨삭 (v0.6) ------------------------------------------------------------
# 기본은 꺼짐. 켜지 않으면 전사·요약 요청 API가 503 (비용·개인정보 보호).
# API 서버와 Worker(`python -m app.worker`)에 같은 값을 설정한다.
STT_ENABLED=false
# faster-whisper: tiny / base / small / medium / large-v3. CPU는 int8 권장
STT_MODEL=small
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
STT_CPU_THREADS=0
STT_BEAM_SIZE=1
STT_LANGUAGE=ko
# 모델 저장 위치 (Worker의 영구 디스크). 비우면 HuggingFace 기본 캐시
STT_MODEL_DIR=
STT_MAX_AUDIO_SECONDS=1200
STT_TIMEOUT_SECONDS=1800
# Worker가 음성을 받을 Signed URL 유효시간 (요청 사용자 토큰으로 발급, service_role 미사용)
STT_SOURCE_URL_SECONDS=21600

AI_SUMMARY_ENABLED=false
# Worker에만 설정. 반드시 유료 등급 키 (무료 등급은 입력이 모델 개선에 쓰일 수 있음). 커밋 금지
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_TIMEOUT_SECONDS=60
GEMINI_MAX_OUTPUT_TOKENS=4096
AI_MAX_TRANSCRIPT_CHARS=30000
# 외부 AI 전송 동의서 버전. 바꾸면 학생이 다시 동의해야 요약 가능
AI_CONSENT_VERSION=2026-11-ai-v1

# 작업 큐·Worker
JOB_MAX_ATTEMPTS=3
JOB_LEASE_SECONDS=300
JOB_RETRY_BASE_SECONDS=30
WORKER_POLL_SECONDS=5

# --- HTTP --------------------------------------------------------------------
# 쉼표로 구분. staging/production 에서 '*' 사용 불가
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Logging -----------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# json | text  (비워두면 development/test=text, 그 외=json)
LOG_FORMAT=
